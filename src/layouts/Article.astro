---
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import {
  getArticles,
  getSidebar,
  renderArticle,
  sidebarScope,
} from '../lib/content.mjs';
import { categoryNames } from '../lib/site.mjs';
interface Props {
  page: import('../lib/content.mjs').ArticleRecord;
}
const { page } = Astro.props;
const { html, headings } = page.body
  ? await renderArticle(page)
  : { html: '', headings: [] };
const groups = getSidebar(page.id);
const scope = sidebarScope(page.id);
const siblings = getArticles().filter((article) =>
  article.id.startsWith(`${scope}/`),
);
const index = siblings.findIndex((article) => article.id === page.id);
const prev = index > 0 ? siblings[index - 1] : undefined;
const next = index >= 0 ? siblings[index + 1] : undefined;
const children = getArticles().filter(
  (article) =>
    article.id.startsWith(page.id.replace(/\/index$/, '') + '/') &&
    article.id !== page.id,
);
const breadcrumbs = page.id
  .split('/')
  .slice(0, -1)
  .map((part, i, parts) => ({
    title: categoryNames[part] || part,
    url: `/${parts.slice(0, i + 1).join('/')}/`,
  }));
const date = page.date
  ? new Intl.DateTimeFormat('zh-CN', {
      dateStyle: 'medium',
      timeZone: 'Asia/Shanghai',
    }).format(new Date(page.date))
  : undefined;
const readingTime = Math.max(
  1,
  Math.ceil((page.body || '').replace(/```[\s\S]*?```/g, '').length / 500),
);
---

<Base
  title={page.title}
  description={page.description}
  canonical={page.url}
  article={!page.generated}
>
  <div class="article-shell VPDoc">
    <aside class="article-sidebar" aria-label="文章导航">
      <details class="sidebar-panel" open>
        <summary>
          文章导航 <Icon name="ChevronDown" size={14} />
        </summary>
        <nav>
          <a class="sidebar-overview" href={`/${scope}/`}>
            {categoryNames[scope.split('/').at(-1) || ''] || page.category} ·
            全部文章
          </a>
          {groups.map((group) => (
            <details
              class="sidebar-group"
              open={group.articles.some((article) => article.id === page.id)}
            >
              <summary>
                <Icon name="ChevronRight" size={12} />
                {group.title}
              </summary>
              <ul>
                {group.articles.map((article) => (
                  <li>
                    <a
                      href={article.url}
                      title={article.title}
                      aria-current={article.id === page.id ? 'page' : undefined}
                    >
                      <Icon name="FileText" size={13} />
                      <span>{article.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          ))}
        </nav>
      </details>
    </aside>
    <main id="main-content" class="article-main content content-container">
      <nav class="breadcrumbs" aria-label="面包屑">
        <a href="/">首页</a>
        {breadcrumbs.map((crumb) => (
          <>
            <Icon name="ChevronRight" size={11} />
            <a href={crumb.url}>{crumb.title}</a>
          </>
        ))}
      </nav>
      <header class="article-header vp-doc">
        <h1>{page.title}</h1>
        <div class="article-meta">
          <span class="article-category">{page.category}</span>
          {date && (
            <span>
              最后更新 <time datetime={page.date}>{date}</time>
            </span>
          )}
          {!page.generated && <span>约 {readingTime} 分钟阅读</span>}
        </div>
      </header>
      {page.body && (
        <article
          class="article-body vp-doc"
          data-pagefind-body
          set:html={html}
        />
      )}
      {(page.generated || page.id.endsWith('/index')) &&
        children.length > 0 && (
          <section class="category-articles" aria-label="分类文章">
            <h2>
              文章目录 <span>{children.length}</span>
            </h2>
            <div class="article-list">
              {children.map((article) => (
                <a class="article-list-item" href={article.url}>
                  <span class="list-category">{article.category}</span>
                  <h3>{article.title}</h3>
                  <p>{article.description}</p>
                </a>
              ))}
            </div>
          </section>
        )}
      {!page.generated && (
        <nav class="article-pager" aria-label="相邻文章">
          {prev ? (
            <a href={prev.url}>
              <span>
                <Icon name="ArrowLeft" size={13} /> 上一篇
              </span>
              <strong>{prev.title}</strong>
            </a>
          ) : (
            <span />
          )}
          {next && (
            <a href={next.url}>
              <span>
                下一篇 <Icon name="ArrowRight" size={13} />
              </span>
              <strong>{next.title}</strong>
            </a>
          )}
        </nav>
      )}
      {!page.generated && page.meta.comment !== false && (
        <section class="comments" aria-label="文章评论">
          <h2>交流与讨论</h2>
          <div class="giscus" data-title={page.title}></div>
        </section>
      )}
    </main>
    {headings.length > 0 && (
      <aside class="article-outline">
        <nav aria-label="本页目录">
          <h2>本页目录</h2>
          <ol>
            {headings.map((heading) => (
              <li class={`depth-${heading.depth}`}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      </aside>
    )}
  </div>
  <div class="article-floating-nav">
    <button
      class="floating-nav-button floating-articles"
      type="button"
      aria-label="打开文章导航"
      aria-haspopup="dialog"
      aria-controls="article-navigation-dialog"
      title="文章导航"
    >
      <Icon name="ListTree" size={21} />
    </button>
    {headings.length > 0 && (
      <button
        class="floating-nav-button floating-outline"
        type="button"
        aria-label="打开本页目录"
        aria-haspopup="dialog"
        aria-controls="page-outline-dialog"
        title="本页目录"
      >
        <Icon name="List" size={21} />
      </button>
    )}
  </div>
  <dialog
    id="article-navigation-dialog"
    class="navigation-dialog"
    aria-labelledby="article-navigation-title"
  >
    <div class="navigation-dialog-header">
      <h2 id="article-navigation-title">文章导航</h2>
      <button type="button" class="close-navigation" aria-label="关闭文章导航">
        <Icon name="X" size={20} />
      </button>
    </div>
    <div class="mobile-nav-content"></div>
  </dialog>
  {headings.length > 0 && (
    <dialog
      id="page-outline-dialog"
      class="navigation-dialog"
      aria-labelledby="page-outline-title"
    >
      <div class="navigation-dialog-header">
        <h2 id="page-outline-title">本页目录</h2>
        <button
          type="button"
          class="close-navigation"
          aria-label="关闭本页目录"
        >
          <Icon name="X" size={20} />
        </button>
      </div>
      <div class="mobile-nav-content"></div>
    </dialog>
  )}
  <div
    id="outline-tooltip"
    class="outline-tooltip"
    role="tooltip"
    popover="manual"
  ></div>
  <template id="copy-code-icons">
    <span data-copy-icon="idle">
      <Icon name="Copy" size={15} />
    </span>
    <span data-copy-icon="copied">
      <Icon name="Check" size={15} />
    </span>
    <span data-copy-icon="error">
      <Icon name="CircleAlert" size={15} />
    </span>
  </template>
  <script>
    import Viewer from 'viewerjs';
    import 'viewerjs/dist/viewer.min.css';
    const panel = document.querySelector<HTMLDetailsElement>('.sidebar-panel');
    if (panel) panel.open = true;
    const navigationSources = [
      {
        id: 'article-navigation-dialog',
        source: '.sidebar-panel',
        maxWidth: 959,
      },
      { id: 'page-outline-dialog', source: '.article-outline', maxWidth: 1250 },
    ];
    for (const { id, source, maxWidth } of navigationSources) {
      const dialog = document.getElementById(id) as HTMLDialogElement | null;
      const parent = document.querySelector(source);
      const navigation = parent?.querySelector('nav');
      const content = dialog?.querySelector('.mobile-nav-content');
      const trigger = document.querySelector<HTMLButtonElement>(
        `[aria-controls="${id}"]`,
      );
      if (!dialog || !parent || !navigation || !content || !trigger) continue;
      trigger.setAttribute('aria-expanded', 'false');
      trigger.addEventListener('click', () => {
        if (!matchMedia(`(max-width: ${maxWidth}px)`).matches) return;
        if (dialog.open) {
          dialog.close();
          return;
        }
        document
          .querySelectorAll<HTMLDialogElement>('.navigation-dialog[open]')
          .forEach((other) => other.close());
        content.appendChild(navigation);
        dialog.showModal();
        trigger.setAttribute('aria-expanded', 'true');
        document.documentElement.classList.add('navigation-modal-open');
      });
      dialog
        .querySelector('.close-navigation')
        ?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog || (event.target as Element).closest('a'))
          dialog.close();
      });
      dialog.addEventListener('close', () => {
        parent.appendChild(navigation);
        trigger.setAttribute('aria-expanded', 'false');
        if (!document.querySelector('.navigation-dialog[open]')) {
          document.documentElement.classList.remove('navigation-modal-open');
          trigger.focus({ preventScroll: true });
        }
      });
      matchMedia(`(min-width: ${maxWidth + 1}px)`).addEventListener(
        'change',
        (event) => {
          if (event.matches && dialog.open) dialog.close();
        },
      );
    }
    const article = document.querySelector<HTMLElement>('.article-body');
    if (article)
      new Viewer(article, {
        toolbar: true,
        navbar: false,
        title: true,
        filter: (image: HTMLImageElement) => !image.closest('a'),
      });
    const copyIcons =
      document.querySelector<HTMLTemplateElement>('#copy-code-icons');
    document
      .querySelectorAll<HTMLButtonElement>('.copy-code')
      .forEach((button) => {
        if (copyIcons)
          button.replaceChildren(copyIcons.content.cloneNode(true));
        button.dataset.state = 'idle';
        button.title = '复制代码';
        let resetTimer: ReturnType<typeof setTimeout>;
        button.addEventListener('click', async () => {
          const code =
            button.closest('.code-block')?.querySelector('code')?.textContent ||
            '';
          clearTimeout(resetTimer);
          try {
            await navigator.clipboard.writeText(code);
            button.dataset.state = 'copied';
            button.title = '已复制';
          } catch {
            button.dataset.state = 'error';
            button.title = '复制失败，请重试';
          }
          button.setAttribute('aria-label', button.title);
          resetTimer = setTimeout(() => {
            button.dataset.state = 'idle';
            button.title = '复制代码';
            button.setAttribute('aria-label', '复制代码');
          }, 1800);
        });
      });
    const links = [
      ...document.querySelectorAll<HTMLAnchorElement>('.article-outline a'),
    ];
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries)
          if (entry.isIntersecting) {
            links.forEach((link) => {
              const active =
                decodeURIComponent(link.hash.slice(1)) === entry.target.id;
              link.classList.toggle('active', active);
              if (active) link.setAttribute('aria-current', 'location');
              else link.removeAttribute('aria-current');
            });
          }
      },
      { rootMargin: '-15% 0px -65% 0px' },
    );
    document
      .querySelectorAll('.article-body h2,.article-body h3,.article-body h4')
      .forEach((heading) => observer.observe(heading));
    const tooltip = document.querySelector<HTMLElement>('#outline-tooltip');
    let tooltipLink: HTMLAnchorElement | undefined;
    const hideOutlineTooltip = () => {
      tooltip?.hidePopover();
      tooltipLink?.removeAttribute('aria-describedby');
      tooltipLink = undefined;
    };
    for (const link of links) {
      const showTooltip = () => {
        if (!tooltip || link.scrollWidth <= link.clientWidth) return;
        hideOutlineTooltip();
        tooltipLink = link;
        tooltip.textContent = link.textContent?.trim() || '';
        link.setAttribute('aria-describedby', 'outline-tooltip');
        tooltip.showPopover();
        const bounds = link.getBoundingClientRect();
        tooltip.style.left = `${Math.max(12, Math.min(bounds.left, innerWidth - tooltip.offsetWidth - 12))}px`;
        tooltip.style.top = `${Math.max(12, Math.min(bounds.bottom + 6, innerHeight - tooltip.offsetHeight - 12))}px`;
      };
      link.addEventListener('pointerenter', showTooltip);
      link.addEventListener('pointerleave', hideOutlineTooltip);
      link.addEventListener('focus', showTooltip);
      link.addEventListener('blur', hideOutlineTooltip);
      link.addEventListener('click', hideOutlineTooltip);
    }
    window.addEventListener('resize', hideOutlineTooltip);
    document.addEventListener('scroll', hideOutlineTooltip, true);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') hideOutlineTooltip();
    });
    const host = document.querySelector<HTMLElement>('.giscus');
    if (host) {
      const script = document.createElement('script');
      script.src = 'https://giscus.app/client.js';
      script.async = true;
      script.crossOrigin = 'anonymous';
      const config = {
        repo: 'imvkmark/wulicode-home',
        'repo-id': 'R_kgDOJfaw1A',
        category: 'General',
        'category-id': 'DIC_kwDOJfaw1M4CW2uA',
        mapping: 'title',
        strict: '0',
        'reactions-enabled': '1',
        'emit-metadata': '0',
        'input-position': 'top',
        theme: document.documentElement.classList.contains('dark')
          ? 'dark'
          : 'light',
        lang: 'zh-CN',
        loading: 'lazy',
      };
      Object.entries(config).forEach(([key, value]) =>
        script.setAttribute(`data-${key}`, value),
      );
      host.appendChild(script);
    }
  </script>
</Base>
