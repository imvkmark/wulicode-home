---
import Base from '../layouts/Base.astro';
import { getArticles } from '../lib/content.mjs';
const articles = [...getArticles()].sort((a, b) =>
  (b.date || '').localeCompare(a.date || ''),
);
const categories = [...new Set(articles.map((article) => article.category))];
---

<Base title="全部文章" description="按分类浏览 Wulicode 的技术文章与开发笔记。">
  <main id="main-content" class="archive-page">
    <header class="article-header">
      <p class="article-category">知识归档</p>
      <h1>全部文章</h1>
      <p class="intro-description">
        {articles.length} 篇开发笔记，持续记录与分享。
      </p>
    </header>
    <div class="archive-filters" role="group" aria-label="筛选文章分类">
      <button class="active" type="button" data-category="" aria-pressed="true">
        全部
      </button>
      {categories.map((category) => (
        <button type="button" data-category={category} aria-pressed="false">
          {category}
        </button>
      ))}
    </div>
    <div class="article-list">
      {articles.map((article) => (
        <a
          class="article-list-item"
          href={article.url}
          data-category={article.category}
        >
          <span class="list-category">{article.category}</span>
          <h2>{article.title}</h2>
          <p>{article.description}</p>
          {article.date && (
            <time datetime={article.date}>{article.date.slice(0, 10)}</time>
          )}
        </a>
      ))}
    </div>
  </main>
  <script>
    document
      .querySelectorAll<HTMLButtonElement>('.archive-filters button')
      .forEach((button) =>
        button.addEventListener('click', () => {
          const category = button.dataset.category;
          document
            .querySelectorAll<HTMLElement>('.archive-filters button')
            .forEach((el) => {
              el.classList.toggle('active', el === button);
              el.setAttribute('aria-pressed', String(el === button));
            });
          document
            .querySelectorAll<HTMLElement>('.article-list-item')
            .forEach(
              (el) =>
                (el.hidden = !!category && el.dataset.category !== category),
            );
        }),
      );
  </script>
</Base>
