{
  "type": "module",
  "scripts": {
    "dev": "astro dev --host --ignore-lock",
    "build": "astro build",
    "preview": "astro preview --host",
    "images:check": "node scripts/check-images.mjs",
    "images:watch": "node scripts/check-images.mjs --watch",
    "test:images": "node --test scripts/check-images.test.mjs",
    "test:content": "node --test test/content.test.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "check": "astro check",
    "format": "prettier --write src astro.config.mjs test scripts/verify-build.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "markdown-it": "^15.0.3",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "@docsearch/css": "^5.2.0",
    "@docsearch/js": "^5.2.0",
    "@lucide/astro": "^1.77.0",
    "astro": "^7.4.13",
    "markdown-it-anchor": "^10.1.0",
    "markdown-it-container": "^4.0.0",
    "sanitize-html": "^2.18.2",
    "shiki": "^4.6.0",
    "viewerjs": "^1.11.7"
  },
  "name": "wulicode-home",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  }
